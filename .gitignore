# ---- 构建产物 ----
bin/
obj/
# pack/ 只放产物，但 manifest 是手写源文件（游戏内模组名/介绍），单独入库
pack/*
!pack/MyChar/
pack/MyChar/*
!pack/MyChar/MyChar.json

# ---- 本地工具链（体积大，可重新获取，不入库）----
# Godot 编辑器 / 导出模板（仅生成动画场景时手动使用，正常编译不需要）
tools/godot/
tools/godot-mono.zip

# ---- 反编译参考源码（查 API 用，第三方代码，不入库）----
ref/

# ---- IDE / 系统 ----
.vs/
.idea/
*.user
*.suo
Thumbs.db
desktop.ini

# ---- Python ----
__pycache__/
*.pyc
build_out.txt
build_err.txt
.workbuddy/

